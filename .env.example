# ==============================================================================
# PoolSafe Integracao (Worker) - Variaveis de Ambiente para Stack Portainer
# Ensaio Inicial Seguro: Modo Video sem Publicacao (CPU)
# ==============================================================================

# Imagem Docker publicada no GitHub Container Registry (GHCR)
# Obrigatória para o Portainer.
# Recomendação para o primeiro ensaio: fixar a tag por commit (ex.: sha-<SHA_40_DIGITOS>)
# Para acompanhar a branch principal: ghcr.io/poolsafe/poolsafe_integracao:main
WORKER_IMAGE=ghcr.io/poolsafe/poolsafe_integracao:main

# Identificacao da Camera e Codigo de Integracao da API
CAMERA_ID=camera_teste_01
CODIGO_INTEGRACAO=

# Modo de Entrada e Fonte
# 'video' para arquivo de ensaio montado localmente; 'stream' para RTSP/HTTP ao vivo
SOURCE_MODE=video
SOURCE=/entrada/teste.mp4

# Diretorios montados do Host (VPS) para o Container
# Padrão de pastas independentes por versão de modelo e ensaio
HOST_MODEL_DIR=/opt/poolsafe/modelos/releases/modelo-002
HOST_VIDEO_DIR=/opt/poolsafe/entrada
HOST_DATA_DIR=/opt/poolsafe/dados/ensaio-modelo-002

# Parametros do Modelo YOLO e Inferencia
# MODEL_PATH é sempre fixo no container: /modelos/best.pt
# Classes aceitas: pessoa_normal (sem evento), pessoa_desequilibrio (ATENCAO), pessoa_queda (CRITICA)
MODEL_VERSION=modelo-002
DEVICE=cpu
CONF=0.25
IOU=0.70
IMGSZ=640

# Modo de Log da Execucao
# 'production' (padrao): registra apenas eventos operacionais, inicio/fim e resumo
# 'development': auditoria detalhada estruturada em JSONL (deteccoes.jsonl) por frame
# 'homologation': resumo por N frames e eventos imediatos destacados
LOG_MODE=development
HOMOLOGATION_LOG_EVERY_N_FRAMES=100
# Auditoria somente em arquivo, apenas no modo homologation.
HOMOLOGATION_DIAGNOSTICS_ENABLED=false
HOMOLOGATION_DIAGNOSTICS_MAX_FRAMES=600
# Vazio: habilita somente em homologation; true/false sobrescrevem o padrão.
CAPTURES_ENABLED=
CAPTURES_INTERVAL_S=1
# Limites por run, incluindo JPEGs e bytes do índice JSONL.
CAPTURES_MAX_COUNT=1000
CAPTURES_MAX_BYTES=524288000

# Modo de Teste e Publicacao (Padrao seguro: SEM publicacao para ensaio inicial)
TEST_MODE=true
ALLOW_TEST_PUBLISH=false
PUBLISH_RABBIT=false
INCLUDE_EVIDENCE=false

# V4 identifica o motor; pesos candidatos: modelo-002.
FRAMES_DESEQUILIBRIO=15
EVIDENCIAS_QUEDA=10
TOLERANCIA_QUEDA_FRAMES=1
FRAMES_NORMAIS_ENCERRAR=15
# Atenção não bloqueia crítica; crítica limita novas críticas por câmera.
COOLDOWN_S=3
# Idade do frame; independente do limite de continuidade.
MAX_INTERVALO_S=0.5
# Stream: lacuna > limite limpa pendências, preservando episódios ativos.
CONTINUIDADE_MAX_INTERVALO_S=2.0

# Heartbeat e TTLs (Heartbeat desativado automaticamente em SOURCE_MODE=video)
HEARTBEAT_INTERVAL_S=30
HEARTBEAT_TTL_S=60
ALERT_TTL_S=0

# Persistencia Local (Outbox SQLite)
MAX_PENDING_EVENTS=10000

# Conexao RabbitMQ (Opcional no ensaio; necessaria apenas quando PUBLISH_RABBIT=true)
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_VHOST=poolsafe
RABBIT_USER=poolsafe_python
RABBIT_PASSWORD=
RABBIT_TLS=false
RABBIT_CA_FILE=
RABBIT_EXCHANGE=poolsafe.events
RABBIT_ALERT_KEY=risk.detected
RABBIT_HEARTBEAT_KEY=camera.heartbeat

# Rede Docker externa compartilhada
DOCKER_NETWORK=poolsafe-network
